# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Naming convention: JIRA_* describes the Jira connection, AIDLC_* configures the
# pipeline itself. No CLAUDE_* prefix — these credentials belong to Jira, not to
# Claude, and naming them otherwise misleads the next reader about what they unlock.

# --- Jira connection (ADR-0003) ---------------------------------------------

# Your Jira Cloud site, scheme included, no trailing slash.
#   e.g. https://acme.atlassian.net
# Not used to connect: the pipeline talks to https://mcp.atlassian.com/v2/mcp
# regardless. It identifies the site to each Jira tool (if JIRA_CLOUD_ID is
# unset) and builds links like {JIRA_SITE_URL}/browse/ABC-123 in fetch output.
# NOT a home.atlassian.com or admin.atlassian.com URL -- those are the admin
# console, not your site. Open Jira and read the address bar.
JIRA_SITE_URL=

# The Atlassian account email that owns the API token below. Required: the token
# alone is not a credential — the header is base64(email:token).
JIRA_EMAIL=

# Scoped personal API token for the MCP server app (appId=mcp-v2), with the
# *:jira:agent-interface scopes. A classic token or a Jira-app token will NOT
# work. Exact link and scopes: docs/SETUP.md step 1b. An org admin must also
# have enabled API-token access to the MCP server (step 1a).
# Acts as the account above. Sandbox use only -- see ADR-0003 "Portability to
# a company setting" for why a company needs a service-account key instead.
JIRA_API_TOKEN=

# Your Atlassian cloud ID (a UUID). Every Jira tool requires a cloudId, and
# the server is not asked to discover it, so set this or JIRA_SITE_URL (the
# server accepts either; verified). This one takes precedence when both are set.
# Find it in the cloudId query parameter of a home.atlassian.com URL, or run
# `aidlc doctor`, which reports the cloud IDs your credentials can reach.
JIRA_CLOUD_ID=

# --- Pipeline configuration -------------------------------------------------

# Jira project key the pipeline is allowed to act on, e.g. KAN. Required from
# Step 2 on: detection searches this project only, so the pipeline cannot act on
# a board nobody pointed it at. Must look like a key (capitals, digits, _).
AIDLC_PROJECT_KEY=

# Exact status name that means "ready for the pipeline to pick up". This is the
# JQL value, which may differ from the board's display name — confirm against the
# real workflow before relying on it (ADR-0006). On the sandbox board: Development.
AIDLC_TRIGGER_STATUS=In development

# Status the card moves to once a PR is open. Not used in Step 1.
AIDLC_DONE_STATUS=In review

# Label added to a card once the pipeline has picked it up, so the next poll
# skips it. Remove the label in Jira to make the pipeline pick the card up
# again. One word, no spaces or commas (ADR-0009).
AIDLC_CLAIM_LABEL=aidlc-claimed

# Seconds between polls in `aidlc watch`. At least 10 (ADR-0006).
AIDLC_POLL_INTERVAL=60

# Model that writes the Stage 3 breakdown (ADR-0010). Pinned so runs stay
# comparable when Claude Code's own default changes. Claude Code on PATH must
# be new enough for it; `aidlc doctor` checks.
AIDLC_BREAKDOWN_MODEL=claude-opus-5-5

# Spending cap per breakdown run, in US dollars, passed to Claude Code as
# --max-budget-usd. Under a Claude subscription this limits usage rather than
# money. Above 0, at most 20.
AIDLC_BREAKDOWN_BUDGET_USD=2.00
